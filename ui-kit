  <style>
    * { -webkit-tap-highlight-color: transparent; }
    body {
      font-feature-settings: "ss01";
      background:
        radial-gradient(1200px 600px at 80% -10%, rgba(0, 128, 255, 0.12), transparent 60%),
        radial-gradient(1000px 500px at 10% 10%, rgba(255, 127, 0, 0.08), transparent 60%),
        #0a1628;
      background-attachment: fixed;
    }

    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.18); }

    .phone-scroll::-webkit-scrollbar { display: none; }
    .phone-scroll { -ms-overflow-style: none; scrollbar-width: none; }

    /* Glass surfaces */
    .glass {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.07);
    }
    .glass-strong {
      background: rgba(255, 255, 255, 0.09);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }

    /* Phone frame */
    .phone-frame {
      width: 360px;
      height: 740px;
      border-radius: 44px;
      background: #0a1628;
      border: 9px solid #161e2e;
      box-shadow:
        0 30px 60px -15px rgba(0,0,0,0.7),
        0 0 0 1px rgba(255,255,255,0.04) inset,
        0 0 80px -20px rgba(0, 128, 255, 0.15);
      overflow: hidden;
      position: relative;
    }
    .phone-frame::before {
      content: '';
      position: absolute;
      top: 0; left: 50%;
      transform: translateX(-50%);
      width: 130px; height: 22px;
      background: #0a1628;
      border-radius: 0 0 18px 18px;
      z-index: 50;
    }

    /* Animations */
    @keyframes slideUp {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    @keyframes sheetUp {
      from { transform: translateY(100%); }
      to { transform: translateY(0); }
    }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes scaleIn {
      from { transform: scale(0.95); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    @keyframes shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.9); opacity: 0.8; }
      80%, 100% { transform: scale(1.6); opacity: 0; }
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .animate-slide-up { animation: slideUp 0.4s ease-out both; }
    .animate-sheet-up { animation: sheetUp 0.3s cubic-bezier(0.32, 0.72, 0, 1) both; }
    .animate-fade-in { animation: fadeIn 0.25s ease-out both; }
    .animate-scale-in { animation: scaleIn 0.25s ease-out both; }

    .skeleton {
      background: linear-gradient(90deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.14) 50%, rgba(255,255,255,0.04) 100%);
      background-size: 200% 100%;
      animation: shimmer 1.6s infinite;
    }

    .pulse-ring {
      position: absolute;
      inset: 0;
      border-radius: 9999px;
      border: 2px solid currentColor;
      animation: pulse-ring 1.6s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
    }

    .spin { animation: spin 0.8s linear infinite; }

    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #0080ff 0%, #ff7f00 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .tabular-nums { font-variant-numeric: tabular-nums; }

    /* Hide on phone screens */
    .no-scrollbar::-webkit-scrollbar { display: none; }

    /* Hide sections initially */
    .section-hidden { display: none; }

    /* Active tab indicator */
    .tab-active {
      background: linear-gradient(135deg, #0080ff 0%, #0066cc 100%);
      color: white;
      box-shadow: 0 8px 20px -8px rgba(0, 128, 255, 0.6);
    }

    /* Bottom sheet container */
    .bottom-sheet {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: none;
    }
    .bottom-sheet.open { display: block; }
    .bottom-sheet-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.6);
      backdrop-filter: blur(4px);
      animation: fadeIn 0.25s ease-out both;
    }
    .bottom-sheet-panel {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      background: #0f1d32;
      border-top-left-radius: 28px;
      border-top-right-radius: 28px;
      max-height: 90vh;
      overflow-y: auto;
      animation: sheetUp 0.35s cubic-bezier(0.32, 0.72, 0, 1) both;
      box-shadow: 0 -20px 60px -10px rgba(0,0,0,0.5);
    }

    /* Toast */
    .toast-container {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 200;
      display: flex;
      flex-direction: column;
      gap: 8px;
      align-items: center;
      pointer-events: none;
    }
    .toast {
      pointer-events: auto;
      animation: slideUp 0.3s ease-out both;
      max-width: 360px;
    }
    .toast.leaving { animation: fadeIn 0.2s ease-out reverse both; }

    /* Number input arrows hide */
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    input[type=number] { -moz-appearance: textfield; }

    /* Progress ring stroke animation */
    .progress-ring circle {
      transition: stroke-dashoffset 0.8s cubic-bezier(0.32, 0.72, 0, 1);
    }

    /* Donut chart segment transitions */
    .donut-segment { transition: stroke-dasharray 0.6s ease-out; }

    /* Tooltip */
    [data-tooltip] { position: relative; }
    [data-tooltip]:hover::after {
      content: attr(data-tooltip);
      position: absolute;
      bottom: calc(100% + 6px);
      left: 50%;
      transform: translateX(-50%);
      background: #1a2d4d;
      color: white;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 11px;
      white-space: nowrap;
      pointer-events: none;
      z-index: 50;
    }
  </style>
</head>
