<!-- JAVASCRIPT -->
<!-- ============================================================ -->
<script>
  // Initialize Lucide icons
  document.addEventListener('DOMContentLoaded', () => {
    if (window.lucide) lucide.createIcons();
  });

  // Scroll to a section
  function scrollToSection(id) {
    document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Screen tab switching
  function switchScreen(name) {
    document.querySelectorAll('[data-screen]').forEach(el => {
      el.classList.toggle('section-hidden', el.dataset.screen !== name);
    });
    document.querySelectorAll('[data-screen-btn]').forEach(btn => {
      const isActive = btn.dataset.screenBtn === name;
      btn.classList.toggle('tab-active', isActive);
      btn.classList.toggle('glass', !isActive);
      btn.classList.toggle('text-fg-muted', !isActive);
    });
    // Re-init icons for newly visible content
    if (window.lucide) lucide.createIcons();
    // Scroll into view
    document.getElementById('screens')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Bottom sheet
  function openBottomSheet(id) {
    const sheet = document.getElementById(id);
    if (!sheet) return;
    sheet.classList.add('open');
    document.body.style.overflow = 'hidden';
    if (window.lucide) lucide.createIcons();
  }
  function closeBottomSheet(id) {
    const sheet = document.getElementById(id);
    if (!sheet) return;
    sheet.classList.remove('open');
    document.body.style.overflow = '';
  }
  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.bottom-sheet.open').forEach(s => s.classList.remove('open'));
      document.body.style.overflow = '';
    }
  });

  // Toast
  const toastConfig = {
    success: { bg: 'bg-success-soft', text: 'text-success', icon: 'check-circle', border: 'border-success/30' },
    error:   { bg: 'bg-danger-soft',  text: 'text-danger',  icon: 'x-circle',       border: 'border-danger/30' },
    info:    { bg: 'bg-info-soft',    text: 'text-purple-300', icon: 'info',         border: 'border-info/30' },
    warning: { bg: 'bg-warning-soft', text: 'text-warning', icon: 'alert-triangle', border: 'border-warning/30' }
  };
  function showToast(message, type = 'info', duration = 3000) {
    const cfg = toastConfig[type] || toastConfig.info;
    const container = document.getElementById('toast-container');
    if (!container) return;
    const toast = document.createElement('div');
    toast.className = `toast glass-strong ${cfg.border} border ${cfg.text} px-4 py-3 rounded-xl shadow-2xl flex items-center gap-2.5 text-sm font-medium`;
    toast.innerHTML = `<i data-lucide="${cfg.icon}" class="w-4 h-4 shrink-0"></i><span>${message}</span>`;
    container.appendChild(toast);
    if (window.lucide) lucide.createIcons();
    setTimeout(() => {
      toast.classList.add('leaving');
      setTimeout(() => toast.remove(), 200);
    }, duration);
  }

  // Number formatting helper (Persian digits + thousand separators)
  function toPersianDigits(num) {
    const persian = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];
    return String(num).replace(/\d/g, d => persian[d]);
  }
  function formatToman(num) {
    return toPersianDigits(num.toLocaleString('en-US'));
  }

  // Animated counters for hero stats (optional, simple)
  document.addEventListener('DOMContentLoaded', () => {
    // Add subtle entrance animation to phone frames
    const phones = document.querySelectorAll('.phone-frame');
    phones.forEach((p, i) => {
      p.style.opacity = '0';
      p.style.transform = 'translateY(20px) scale(0.98)';
      p.style.transition = 'opacity 0.5s ease-out, transform 0.5s ease-out';
      setTimeout(() => {
        p.style.opacity = '1';
        p.style.transform = 'translateY(0) scale(1)';
      }, 80 + i * 60);
    });
  });

  // Close bottom sheet when clicking outside panel
  document.querySelectorAll('.bottom-sheet').forEach(sheet => {
    sheet.addEventListener('click', (e) => {
      if (e.target === sheet || e.target.classList.contains('bottom-sheet-backdrop')) {
        sheet.classList.remove('open');
        document.body.style.overflow = '';
      }
    });
  });
</script>

